# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Xcode (project is generated by XcodeGen from project.yml) ───────────────
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
DerivedData/
/build/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
timeline.xctimeline
playground.xcworkspace

# ── Generated by XcodeGen from project.yml (edit project.yml, not these) ────
/VoxFlow/Info.plist

# ── Swift Package Manager ───────────────────────────────────────────────────
.build/
.swiftpm/
# VoxFlowKit/Package.resolved IS tracked (reproducible builds). Only the copy Xcode
# writes inside the generated project is ignored (and that directory is ignored anyway).

# ── Test output ─────────────────────────────────────────────────────────────
*.xcresult
TestResults/
*.profraw
*.profdata
*.log

# ── Models and media (downloaded at runtime, never committed) ───────────────
# Speech/LLM model files live in ~/Library/Application Support/VoxFlow/Models, not in the repo.
*.bin
*.gguf
*.mlmodelc
*.mlpackage
# Media fixtures: only short WAVs (< 1 MB each) are tracked; compressed formats are not.
**/Fixtures/*.m4a
**/Fixtures/*.mp3
**/Fixtures/*.mp4
**/Fixtures/*.mov
!**/Fixtures/**/*.wav

# ── Signing, secrets, local config ──────────────────────────────────────────
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
.env
.env.*
*.local.json
ExportOptions.local.plist

# ── Tooling ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.swiftlint-cache/
